// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum StatusPayment {
  PENDING
  PAID
  FAILED
  CANCELED
}

enum PaymentProvider {
  XENDIT
}

enum DocumentGuideStatus {
  draft
  published
}

/// Public PDF preview: `hide` = only first N pages; `show` = full document.
enum DocumentGuidePreviewMode {
  hide
  show
}

enum ReviewStatus {
  pending
  published
  rejected
}

enum LegalSlug {
  terms
  privacy
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  password     String
  role         Role           @default(USER)
  displayName  String?
  avatarFilename String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  countryId    Int?
  country      Country?       @relation(fields: [countryId], references: [id])
  order        Order[]
  review       Review[]
  refreshToken RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  expiredAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Region {
  id                     Int                      @id @default(autoincrement())
  name                   String
  countries              Country[]
  tagDocumentDestination TagDocumentDestination[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}

model Country {
  id                     Int                      @id @default(autoincrement())
  name                   String
  regionId               Int
  region                 Region                   @relation(fields: [regionId], references: [id])
  /// Optional map pin (Phase 1 adventure map).
  latitude               Float?
  longitude              Float?
  city                   City[]
  tagDocumentDestination TagDocumentDestination[]
  user                   User[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}

model City {
  id                     Int                      @id @default(autoincrement())
  name                   String
  countryId              Int
  country                Country                  @relation(fields: [countryId], references: [id])
  /// Optional map pin (Phase 1 adventure map).
  latitude               Float?
  longitude              Float?
  tagDocumentDestination TagDocumentDestination[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}

model DocumentGuide {
  id                     String                     @id @default(uuid())
  titleId                String
  titleEn                String?
  /// Optional short description shown on public cards (Indonesian).
  description            String?
  /// Optional English description for public cards when locale is en.
  descriptionEn          String?
  nameDocument           String
  tripDays               Int?
  priceIdr               Decimal?                   @db.Decimal(15, 2)
  priceUsd               Decimal?                   @db.Decimal(15, 2)
  status                 DocumentGuideStatus        @default(draft)
  /// Public preview: hide = limited pages; show = full PDF (public).
  previewMode            DocumentGuidePreviewMode   @default(hide)
  /// Used only when previewMode = hide. Default 3.
  previewPageCount       Int                        @default(3)
  tagDocumentDestination TagDocumentDestination[]
  coverImages            DocumentGuideImage[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  order                  Order[]
  review                 Review[]
}

model DocumentGuideImage {
  id              String        @id @default(uuid())
  documentGuideId String
  documentGuide   DocumentGuide @relation(fields: [documentGuideId], references: [id], onDelete: Cascade)
  filename        String
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
}

model TagDocumentDestination {
  id              Int           @id @default(autoincrement())
  documentGuideId String
  regionId        Int
  countryId       Int?
  cityId          Int?
  documentGuide   DocumentGuide @relation(fields: [documentGuideId], references: [id])
  region          Region        @relation(fields: [regionId], references: [id])
  country         Country?      @relation(fields: [countryId], references: [id])
  city            City?         @relation(fields: [cityId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Order {
  id                   String          @id @default(uuid())
  price                Decimal         @db.Decimal(15, 2)
  currency             String
  userId               String
  documentGuideId      String
  statusPayment        StatusPayment   @default(PENDING)
  paymentProvider      PaymentProvider
  gatewayTransactionId String?
  paymentUrl           String?
  paidAt               DateTime?
  emailDeliveredAt     DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  documentGuide        DocumentGuide   @relation(fields: [documentGuideId], references: [id])
  user                 User            @relation(fields: [userId], references: [id])
}

model Review {
  id              String        @id @default(uuid())
  userId          String
  documentGuideId String
  rating          Int
  comment         String
  displayName     String
  travelerRole    String?
  status          ReviewStatus  @default(pending)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentGuide   DocumentGuide @relation(fields: [documentGuideId], references: [id], onDelete: Cascade)

  @@unique([userId, documentGuideId])
  @@index([status, createdAt])
}

/// CMS rows for public /terms and /privacy. Seeded once; admin edits after that.
model LegalDocument {
  id               String    @id @default(uuid())
  slug             LegalSlug @unique
  titleId          String
  titleEn          String
  titleHighlightId String
  titleHighlightEn String
  introId          String    @db.Text
  introEn          String    @db.Text
  bodyId           String    @db.Text
  bodyEn           String    @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
