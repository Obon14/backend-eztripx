# Server
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

# Database (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ez_tripx

# JWT — generate strong random strings (min 32 chars each)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRED=15m
JWT_REFRESH_EXPIRED=3d

# Xendit (payment — required for order/checkout)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxx
# Webhook verification token from Xendit Dashboard → Developers → Webhooks
XENDIT_WEBHOOKS=your-webhook-verification-token
# Where Xendit redirects user after successful payment
PAYMENT_RETURN_URL=http://localhost:3000
# DEV ONLY: bypass Xendit and mark order PAID immediately (will trigger email send flow)
PAYMENT_BYPASS=false
# Optional alias: CORS_ORIGINS is also accepted if ALLOWED_ORIGINS is unset

# Document uploads (optional; default: ./uploads/document-guides)
# DOCUMENT_GUIDE_UPLOAD_DIR=uploads/document-guides

# Machine REST create (POST /api/document-guides) — static API key, no JWT.
# Leave unset to keep the endpoint disabled (401). Use a long random secret.
# DOCUMENT_GUIDE_INGEST_KEY=change-me-long-random-ingest-key

# Hostinger Mail API — kirim PDF ke email setelah pembayaran PAID
# Token: Hostinger Email panel → Agentic Mail → API access
HOSTINGER_MAIL_API_TOKEN=your-hostinger-mail-api-token
# Mailbox resource ID (contoh: AC1a2b3c4d5e6f7g), bisa didapat dari endpoint GET /api/v1/me
HOSTINGER_MAILBOX_ID=ACxxxxxxxxxxxxxxxx
# Sender address harus mailbox Hostinger yang diizinkan token
MAIL_FROM=contact@eztripx.com
MAIL_FROM_NAME=EzTripx

# Seed admin (run: npx prisma db seed)
SEED_ADMIN_EMAIL=admin@ez-trip-x.local
SEED_ADMIN_PASSWORD=change-me-strong-password
# SEED_ADMIN_RESET_PASSWORD=1
